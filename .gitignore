# =============================================================================
# olt — .gitignore
# =============================================================================

# ── Build output ──────────────────────────────────────────────────────────────
# Binaries are built, not committed: ./scripts/build.sh writes artifacts/<platform>/olt.
/artifacts/
/odin-lint
/olt

# ── Generated code graph ──────────────────────────────────────────────────────
.codegraph/

# ── Test output (generated, not source) ───────────────────────────────────────
test_results/

# ── Local developer files (not shared) ────────────────────────────────────────
CLAUDE.md
CLAUDE.md.bak-*
AGENTS.md
agents.md
SKILL.md
# Per-checkout pin of a local project-memory tool.
.ai-memory.toml
# plans is a symlink to a folder outside this repository, so the pattern has NO trailing slash
# ("plans/" only matches a real directory, not a symlink).
plans
# Shared documentation symlinks that point outside this repository.
ODIN_MEMORY.md
ODIN_STYLE.md
ODIN_PROJECT_RAILS.md
ODIN_PRINCIPLES.md

# ── Editors and file-sync tools ───────────────────────────────────────────────
.idea/
**/*_Conflict

# ── macOS metadata ────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Python cache ──────────────────────────────────────────────────────────────
**/__pycache__/
*.pyc
